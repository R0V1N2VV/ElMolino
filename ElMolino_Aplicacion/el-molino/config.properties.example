# Copia este archivo como config.properties y completa los datos de tu entorno.
db.host=HOST_MYSQL
db.port=3306
db.name=NOMBRE_BASE
db.user=USUARIO
db.password=CONTRASENA

# Opcional, solo para demostrar llegadas y egresos sin esperar la fecha real.
# Escribí una fecha AAAA-MM-DD, por ejemplo 2026-11-18. Dejala vacía en uso normal.
app.fecha_prueba=
# Opcional junto a la fecha de prueba. Formato HH:MM, por ejemplo 14:30.
app.hora_prueba=
